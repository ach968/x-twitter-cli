{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:x-twt-cli:schema:search-timeline",
  "title": "x-twt SearchTimeline page",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "tab", "results", "next_cursor", "warnings"],
  "properties": {
    "query": { "type": "string" },
    "tab": {
      "enum": ["top", "latest", "people", "media", "lists"]
    },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/result" }
    },
    "next_cursor": { "type": ["string", "null"] },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    }
  },
  "$defs": {
    "result": {
      "oneOf": [
        { "$ref": "#/$defs/post" },
        { "$ref": "#/$defs/user" },
        { "$ref": "#/$defs/list" }
      ]
    },
    "verification": {
      "enum": ["premium", "organization", "government", null]
    },
    "userRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "username",
        "url",
        "avatar_url",
        "verification",
        "protected"
      ],
      "properties": {
        "id": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "username": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "avatar_url": { "type": ["string", "null"] },
        "verification": { "$ref": "#/$defs/verification" },
        "protected": { "type": ["boolean", "null"] }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "display_url"],
      "properties": {
        "url": { "type": "string" },
        "display_url": { "type": ["string", "null"] }
      }
    },
    "replyTo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["post_id", "user_id", "username"],
      "properties": {
        "post_id": { "type": ["string", "null"] },
        "user_id": { "type": ["string", "null"] },
        "username": { "type": ["string", "null"] }
      }
    },
    "postMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replies",
        "reposts",
        "quotes",
        "likes",
        "bookmarks",
        "views"
      ],
      "properties": {
        "replies": { "$ref": "#/$defs/count" },
        "reposts": { "$ref": "#/$defs/count" },
        "quotes": { "$ref": "#/$defs/count" },
        "likes": { "$ref": "#/$defs/count" },
        "bookmarks": { "$ref": "#/$defs/count" },
        "views": { "$ref": "#/$defs/count" }
      }
    },
    "count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "url",
        "preview_url",
        "width",
        "height",
        "alt_text",
        "duration_ms"
      ],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["image", "video", "animated_gif"] },
        "url": { "type": ["string", "null"] },
        "preview_url": { "type": ["string", "null"] },
        "width": { "$ref": "#/$defs/count" },
        "height": { "$ref": "#/$defs/count" },
        "alt_text": { "type": ["string", "null"] },
        "duration_ms": { "$ref": "#/$defs/count" }
      }
    },
    "communityNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "language", "sources", "url"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "language": { "type": ["string", "null"] },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        },
        "url": { "type": ["string", "null"] }
      }
    },
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "url",
        "text",
        "author",
        "created_at",
        "language",
        "conversation_id",
        "reply_to",
        "metrics",
        "possibly_sensitive",
        "links",
        "mentions",
        "hashtags",
        "cashtags",
        "media",
        "quoted_post",
        "community_note"
      ],
      "properties": {
        "type": { "const": "post" },
        "id": { "type": "string" },
        "url": { "type": ["string", "null"] },
        "text": { "type": "string" },
        "author": {
          "oneOf": [
            { "$ref": "#/$defs/userRef" },
            { "type": "null" }
          ]
        },
        "created_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "language": { "type": ["string", "null"] },
        "conversation_id": { "type": ["string", "null"] },
        "reply_to": {
          "oneOf": [
            { "$ref": "#/$defs/replyTo" },
            { "type": "null" }
          ]
        },
        "metrics": { "$ref": "#/$defs/postMetrics" },
        "possibly_sensitive": { "type": ["boolean", "null"] },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        },
        "mentions": {
          "type": "array",
          "items": { "$ref": "#/$defs/userRef" }
        },
        "hashtags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cashtags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "media": {
          "type": "array",
          "items": { "$ref": "#/$defs/media" }
        },
        "quoted_post": {
          "oneOf": [
            { "$ref": "#/$defs/post" },
            { "type": "null" }
          ]
        },
        "community_note": {
          "oneOf": [
            { "$ref": "#/$defs/communityNote" },
            { "type": "null" }
          ]
        }
      }
    },
    "affiliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "badge_url"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "badge_url": { "type": ["string", "null"] }
      }
    },
    "professional": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "categories"],
      "properties": {
        "type": { "type": ["string", "null"] },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "userMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["followers", "following", "posts", "media"],
      "properties": {
        "followers": { "$ref": "#/$defs/count" },
        "following": { "$ref": "#/$defs/count" },
        "posts": { "$ref": "#/$defs/count" },
        "media": { "$ref": "#/$defs/count" }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "name",
        "username",
        "url",
        "bio",
        "avatar_url",
        "banner_url",
        "website_url",
        "verification",
        "identity_verified",
        "protected",
        "affiliation",
        "automated_by",
        "parody_commentary_fan",
        "professional",
        "metrics"
      ],
      "properties": {
        "type": { "const": "user" },
        "id": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "username": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "bio": { "type": ["string", "null"] },
        "avatar_url": { "type": ["string", "null"] },
        "banner_url": { "type": ["string", "null"] },
        "website_url": { "type": ["string", "null"] },
        "verification": { "$ref": "#/$defs/verification" },
        "identity_verified": { "type": ["boolean", "null"] },
        "protected": { "type": ["boolean", "null"] },
        "affiliation": {
          "oneOf": [
            { "$ref": "#/$defs/affiliation" },
            { "type": "null" }
          ]
        },
        "automated_by": {
          "oneOf": [
            { "$ref": "#/$defs/userRef" },
            { "type": "null" }
          ]
        },
        "parody_commentary_fan": {
          "enum": ["parody", "commentary", "fan", null]
        },
        "professional": {
          "oneOf": [
            { "$ref": "#/$defs/professional" },
            { "type": "null" }
          ]
        },
        "metrics": { "$ref": "#/$defs/userMetrics" }
      }
    },
    "listMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["members", "subscribers"],
      "properties": {
        "members": { "$ref": "#/$defs/count" },
        "subscribers": { "$ref": "#/$defs/count" }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "name",
        "description",
        "url",
        "owner",
        "private",
        "banner_url",
        "metrics"
      ],
      "properties": {
        "type": { "const": "list" },
        "id": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "owner": {
          "oneOf": [
            { "$ref": "#/$defs/userRef" },
            { "type": "null" }
          ]
        },
        "private": { "type": ["boolean", "null"] },
        "banner_url": { "type": ["string", "null"] },
        "metrics": { "$ref": "#/$defs/listMetrics" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
