{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:x-twitter-cli:schema:search-timeline",
  "title": "x-twitter-cli SearchTimeline page",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "tab", "results", "next_cursor", "warnings"],
  "properties": {
    "query": { "type": "string" },
    "tab": {
      "enum": ["top", "latest", "people", "media", "lists"]
    },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/result" }
    },
    "next_cursor": { "type": ["string", "null"] },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    }
  },
  "$defs": {
    "result": {
      "oneOf": [
        { "$ref": "urn:x-twitter-cli:schema:shared-post#/$defs/post" },
        { "$ref": "#/$defs/user" },
        { "$ref": "#/$defs/list" }
      ]
    },
    "verification": {
      "enum": ["premium", "organization", "government", null]
    },
    "count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "affiliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "badge_url"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "badge_url": { "type": ["string", "null"] }
      }
    },
    "professional": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "categories"],
      "properties": {
        "type": { "type": ["string", "null"] },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "userMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["followers", "following", "posts", "media"],
      "properties": {
        "followers": { "$ref": "#/$defs/count" },
        "following": { "$ref": "#/$defs/count" },
        "posts": { "$ref": "#/$defs/count" },
        "media": { "$ref": "#/$defs/count" }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "name",
        "username",
        "url",
        "bio",
        "avatar_url",
        "banner_url",
        "website_url",
        "verification",
        "identity_verified",
        "protected",
        "affiliation",
        "automated_by",
        "parody_commentary_fan",
        "professional",
        "metrics"
      ],
      "properties": {
        "type": { "const": "user" },
        "id": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "username": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "bio": { "type": ["string", "null"] },
        "avatar_url": { "type": ["string", "null"] },
        "banner_url": { "type": ["string", "null"] },
        "website_url": { "type": ["string", "null"] },
        "verification": { "$ref": "#/$defs/verification" },
        "identity_verified": { "type": ["boolean", "null"] },
        "protected": { "type": ["boolean", "null"] },
        "affiliation": {
          "oneOf": [
            { "$ref": "#/$defs/affiliation" },
            { "type": "null" }
          ]
        },
        "automated_by": {
          "oneOf": [
            { "$ref": "urn:x-twitter-cli:schema:shared-post#/$defs/userRef" },
            { "type": "null" }
          ]
        },
        "parody_commentary_fan": {
          "enum": ["parody", "commentary", "fan", null]
        },
        "professional": {
          "oneOf": [
            { "$ref": "#/$defs/professional" },
            { "type": "null" }
          ]
        },
        "metrics": { "$ref": "#/$defs/userMetrics" }
      }
    },
    "listMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["members", "subscribers"],
      "properties": {
        "members": { "$ref": "#/$defs/count" },
        "subscribers": { "$ref": "#/$defs/count" }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "name",
        "description",
        "url",
        "owner",
        "private",
        "banner_url",
        "metrics"
      ],
      "properties": {
        "type": { "const": "list" },
        "id": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "owner": {
          "oneOf": [
            { "$ref": "urn:x-twitter-cli:schema:shared-post#/$defs/userRef" },
            { "type": "null" }
          ]
        },
        "private": { "type": ["boolean", "null"] },
        "banner_url": { "type": ["string", "null"] },
        "metrics": { "$ref": "#/$defs/listMetrics" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
